{
  "applications": {
    "generic-rag-example": {
      "displayName": "Generic RAG Example Application",
      "description": "Generic RAG Example Application.",
      "descriptionKeywords": [
        "RAG"
      ],
      "applicationTypeSchemaId": "https://dial.epam.com/application_type_schemas/generic-rag",
      "applicationProperties": {
        "metadata_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "DocumentMetadataSchema",
          "type": "object",
          "properties": {
            "category": {
              "$comment": "string field that can be used for enum-like documents filtering, exposed in mcp",
              "type": "string",
              "enable_filtering": true,
              "enable_in_mcp_retrieve_chunks": true
            },
            "published_on": {
              "$comment": "date field that can be used for documents filtering, exposed in mcp",
              "type": "string",
              "format": "date",
              "enable_filtering": true,
              "enable_in_mcp_retrieve_chunks": true
            },
            "description": {
              "$comment": "string field with some additional info about document, exposed in mcp, cannot be used for filtering",
              "type": "string",
              "enable_in_mcp_retrieve_chunks": true
            },
            "tags": {
              "$comment": "string array field that can be used for filtering, not exposed in mcp",
              "type": "array",
              "items": {
                "type": "string"
              },
              "enable_filtering": true
            },
            "external_url": {
              "$comment": "a url, cannot be used for filtering nor exposed in mcp",
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": true
        },
        "parsers": [
          {
            "type": "unstructured_parser"
          },
          {
            "type": "page_extractor"
          }
        ],
        "indexes": {
          "keyword-elastic": {
            "type": "chunk",
            "display_name": "Keyword search",
            "indexer": {
              "type": "text_normalizer",
              "language": "english"
            },
            "storage": {
              "backend": "elastic"
            }
          },
          "generic-rag-embeddings": {
            "type": "chunk",
            "display_name": "Semantic search",
            "indexer": {
              "type": "text_embeddings",
              "deployment_name": "generic-rag-embeddings"
            }
          }
        },
        "retriever": {
          "type": "classic",
          "document_selector": {
            "type": "explicit"
          }
        },
        "generation": {
          "type": "default",
          "llm": {
            "deployment_name": "gpt-4.1-2025-04-14"
          }
        }
      }
    }
  },
  "applicationTypeSchemas": [
    {
      "$schema": "https://dial.epam.com/application_type_schemas/schema#",
      "$id": "https://dial.epam.com/application_type_schemas/generic-rag",
      "dial:applicationTypeCompletionEndpoint": "${GENERIC_RAG_URL}/openai/deployments/generic-rag/chat/completions",
      "dial:applicationTypeConfigurationEndpoint": "${GENERIC_RAG_URL}/openai/deployments/generic-rag/configuration",
      "dial:applicationTypeSchemaEndpoint": "${GENERIC_RAG_URL}/application-type-schema",
      "dial:applicationTypeDisplayName": "Generic RAG",
      "dial:applicationTypeIconUrl": "RAG_files_search.svg",
      "dial:applicationTypeRoutes": {
        "channel": {
          "dial:paths": [
            "/channel(/[^/]+)*$"
          ],
          "dial:rewritePath": true,
          "dial:methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ],
          "dial:upstreams": [
            {
              "dial:endpoint": "${GENERIC_RAG_URL}"
            }
          ]
        }
      },
      "dial:applicationTypeMcp": {
        "dial:endpoint": "${GENERIC_RAG_URL}/mcp/streamable-http",
        "dial:transport": "HTTP",
        "dial:mcpConfigDelivery": "HEADER",
        "dial:forwardPerRequestKey": true
      },
      "dial:appendApplicationPropertiesHeader": false
    }
  ],
  "models": {
